{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argent Studio",
  "version": "0.45.0",
  "identifier": "studio.argent.tauri",
  "build": {"beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420", "devUrl": "http://localhost:1420", "beforeBuildCommand": "node node_modules/vite/bin/vite.js build", "frontendDist": "../dist"},
  "app": {"windows": [{"title": "Argent Studio", "width": 1450, "height": 930, "minWidth": 1150, "minHeight": 720}], "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"}},
  "bundle": {"active": true, "icon": ["icons/icon.ico", "icons/icon.png"], "targets": "all", "resources": {"../resources/": "resources/"}}
}
